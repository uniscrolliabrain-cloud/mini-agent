# Copia este fichero a .env y rellena los valores.
#   cp .env.example .env

# --- Gemini (obligatorio) -> https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Google OAuth (obligatorio para Gmail/Drive/Calendar) ---
# Scopes necesarios: gmail.readonly, gmail.send, gmail.compose,
# drive.readonly, calendar.readonly, calendar.events
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Discord (opcional) ---
DISCORD_BOT_TOKEN=
DISCORD_DEFAULT_CHANNEL_ID=

# --- API HTTP ---
# Obligatoria: si esta vacia la API responde 503 (fail closed).
# El frontend la envia en la cabecera X-API-Key (VITE_API_KEY).
ADMIN_API_KEY=
# Origenes permitidos por CORS, separados por comas.
CORS_ORIGINS=http://localhost:5173,http://localhost:8501

# --- Comportamiento ---
# Zona horaria para eventos de Calendar sin offset explicito (nombre IANA).
DEFAULT_TIMEZONE=Europe/Madrid
# Carpeta donde se guarda data/<user_id>/memory.json (por defecto ./data).
# DATA_DIR=
